---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  pie?: string;
  className?: string;
}

const { src, alt, title, pie, className = '' } = Astro.props;
---

<figure class={`my-8 ${className}`}>
  <Image
    src={src}
    alt={alt}
    title={title}
    class="w-full max-w-4xl mx-auto rounded-lg shadow-md"
    widths={[400, 600, 800, 1200]}
    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
  />
  {pie && (
    <figcaption class="text-center text-sm text-gray-600 mt-3 px-4 break-words max-w-full overflow-hidden" set:html={pie} />
  )}
</figure>
