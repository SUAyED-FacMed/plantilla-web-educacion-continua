---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@/styles/carrusel.css';

type ImagenCarrusel = ImageMetadata | string;
type VarianteCarrusel = 'carta1' | 'carta2' | 'carta3' | 'carta4' | 'azul' | 'dorado' | 'neutra';
type AjusteImagen = 'contain' | 'cover';

interface SlideCarrusel {
  id?: string | number;
  titulo?: string;
  subtitulo?: string;
  texto?: string;
  contenido?: string;
  imagen?: ImagenCarrusel;
  alt?: string;
  title?: string;
  pie?: string;
  variante?: VarianteCarrusel;
}

interface Props {
  id?: string;
  slides?: SlideCarrusel[];
  titulo?: string;
  descripcion?: string;
  ariaLabel?: string;
  variante?: VarianteCarrusel;
  ajusteImagen?: AjusteImagen;
  mostrarControles?: boolean;
  mostrarIndicadores?: boolean;
  loop?: boolean;
  autoPlay?: boolean;
  intervalo?: number;
  class?: string;
}

const {
  id,
  slides = [],
  titulo,
  descripcion,
  ariaLabel = titulo ?? 'Carrusel de contenido',
  variante = 'carta1',
  ajusteImagen = 'cover',
  mostrarControles = true,
  mostrarIndicadores = true,
  loop = false,
  autoPlay = false,
  intervalo = 7000,
  class: className = '',
} = Astro.props;

const uid = id ?? `carrusel-${Math.random().toString(36).slice(2, 9)}`;
const totalSlides = slides.length;
const hasStructuredSlides = totalSlides > 0;
const getImageSrc = (imagen?: ImagenCarrusel) => typeof imagen === 'string' ? imagen : imagen?.src;
---

<section
  class:list={['carrusel', `carrusel--${variante}`, className]}
  id={uid}
  role="region"
  aria-roledescription="carrusel"
  aria-label={ariaLabel}
  data-carrusel
  data-loop={loop ? 'true' : 'false'}
  data-autoplay={autoPlay ? 'true' : 'false'}
  data-intervalo={intervalo}
>
  {(titulo || descripcion) && (
    <header class="carrusel__header">
      {titulo && <h2 class="carrusel__titulo">{titulo}</h2>}
      {descripcion && <p class="carrusel__descripcion">{descripcion}</p>}
    </header>
  )}

  <div class="carrusel__shell">
    <div class="carrusel__viewport" id={`${uid}-viewport`} tabindex="0">
      <div class="carrusel__track">
        {slides.map((slide, index) => {
          const slideId = `${uid}-slide-${slide.id ?? index + 1}`;
          const slideTitle = slide.titulo ?? `Diapositiva ${index + 1}`;
          const slideVariant = slide.variante ?? variante;
          const imageSrc = getImageSrc(slide.imagen);
          const imageAlt = slide.alt ?? '';
          const safeSlideId = String(slide.id ?? index + 1).replace(/[^a-zA-Z0-9_-]/g, '-');
          const dialogId = `${uid}-imagen-${index}-${safeSlideId}`;

          return (
            <article
              class:list={[
                'carrusel__slide',
                'slider__section',
                `carrusel__slide--${slideVariant}`,
                index === 0 && 'is-active',
                index === 0 && 'activo',
              ]}
              id={slideId}
              aria-roledescription="diapositiva"
              aria-label={`${index + 1} de ${totalSlides}`}
              data-carrusel-slide
            >
              <div class:list={['carrusel__slide-grid', slide.imagen && 'has-media']}>
                {slide.imagen && imageSrc && (
                  <figure class:list={['carrusel__media', `carrusel__media--${ajusteImagen}`]}>
                    <button
                      class="carrusel__image-button"
                      type="button"
                      aria-label="Ampliar imagen"
                      data-dialog-target={dialogId}
                    >
                      {typeof slide.imagen === 'string' ? (
                        <img
                          src={slide.imagen}
                          alt={imageAlt}
                          title={slide.title}
                          loading="lazy"
                          class="carrusel__img slider__img"
                        />
                      ) : (
                        <Image
                          src={slide.imagen}
                          alt={imageAlt}
                          title={slide.title}
                          widths={[360, 520, 720, 960]}
                          sizes="(max-width: 720px) 100vw, 42vw"
                          loading="lazy"
                          class="carrusel__img slider__img"
                        />
                      )}
                      <span class="carrusel__zoom-indicator" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                          <path d="M10.5 4a6.5 6.5 0 0 1 5.15 10.46l4.44 4.45-1.41 1.41-4.45-4.44A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm.75 1.75v2h2v1.5h-2v2h-1.5v-2h-2v-1.5h2v-2h1.5Z"></path>
                        </svg>
                      </span>
                    </button>
                    {slide.pie && <figcaption set:html={slide.pie} />}
                  </figure>
                )}
                {slide.imagen && imageSrc && (
                  <dialog class="carrusel__dialog" id={dialogId} aria-label="Imagen ampliada">
                    <button class="carrusel__dialog-close" type="button" aria-label="Cerrar imagen ampliada" data-dialog-close>
                      <span aria-hidden="true">&times;</span>
                    </button>
                    <img class="carrusel__dialog-image" src={imageSrc} alt={imageAlt} loading="lazy" />
                    {slide.pie && <p class="carrusel__dialog-caption" set:html={slide.pie}></p>}
                  </dialog>
                )}

                <div class="carrusel__content">
                  {slide.subtitulo && <p class="carrusel__subtitulo">{slide.subtitulo}</p>}
                  {slide.titulo && <h3 class="carrusel__slide-title">{slide.titulo}</h3>}
                  {slide.texto && <p class="carrusel__texto">{slide.texto}</p>}
                  {slide.contenido && <div class="carrusel__html" set:html={slide.contenido} />}
                  {!slide.titulo && !slide.texto && !slide.contenido && (
                    <span class="sr-only">{slideTitle}</span>
                  )}
                </div>
              </div>
            </article>
          );
        })}

        {!hasStructuredSlides && <slot />}
      </div>
    </div>

    {mostrarControles && (
      <div class="carrusel__controls" aria-label="Controles del carrusel">
        <button
          class="carrusel__control carrusel__control--prev slider__btn slider__btn__regresa"
          type="button"
          aria-label="Ver diapositiva anterior"
          aria-controls={`${uid}-viewport`}
          data-carrusel-prev
          disabled={!loop && totalSlides <= 1}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M14.7 5.3a1 1 0 0 1 0 1.4L9.42 12l5.3 5.3a1 1 0 0 1-1.42 1.4l-6-6a1 1 0 0 1 0-1.4l6-6a1 1 0 0 1 1.4 0Z" />
          </svg>
        </button>
        <button
          class="carrusel__control carrusel__control--next slider__btn slider__btn__avanza"
          type="button"
          aria-label="Ver diapositiva siguiente"
          aria-controls={`${uid}-viewport`}
          data-carrusel-next
          disabled={!loop && totalSlides <= 1}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M9.3 18.7a1 1 0 0 1 0-1.4l5.28-5.3-5.3-5.3a1 1 0 0 1 1.42-1.4l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4 0Z" />
          </svg>
        </button>
      </div>
    )}
  </div>

  {mostrarIndicadores && (
    <div class="carrusel__dots puntos" role="tablist" aria-label="Elegir diapositiva" data-carrusel-dots>
      {slides.map((slide, index) => (
        <button
          class:list={['carrusel__dot', 'punto', index === 0 && 'is-active', index === 0 && 'activo']}
          type="button"
          role="tab"
          aria-label={`Ir a diapositiva ${index + 1}`}
          aria-controls={`${uid}-slide-${slide.id ?? index + 1}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          data-carrusel-dot={index}
        />
      ))}
    </div>
  )}
</section>

<script>
  type CarruselRoot = HTMLElement;
  type CarruselSlide = HTMLElement;
  type CarruselDot = HTMLButtonElement;
  type CarruselDialog = HTMLDialogElement;

  const initializeCarrusel = (root: CarruselRoot) => {
    if (root.dataset.carruselReady === 'true') return;

    const viewport = root.querySelector<HTMLElement>('.carrusel__viewport');
    const slides = Array.from(root.querySelectorAll<CarruselSlide>('[data-carrusel-slide], .carrusel__slide'));
    const prevButton = root.querySelector<HTMLButtonElement>('[data-carrusel-prev]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-carrusel-next]');
    const dotsContainer = root.querySelector<HTMLElement>('[data-carrusel-dots]');
    const imageButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.carrusel__image-button'));
    const dialogs = Array.from(root.querySelectorAll<CarruselDialog>('.carrusel__dialog'));
    const loop = root.dataset.loop === 'true';
    const autoplay = root.dataset.autoplay === 'true';
    const interval = Number(root.dataset.intervalo) || 7000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let autoplayTimer: number | undefined;

    if (!viewport || slides.length === 0) {
      root.dataset.carruselReady = 'true';
      return;
    }

    root.dataset.carruselReady = 'true';

    if (dotsContainer && dotsContainer.children.length === 0) {
      slides.forEach((slide, index) => {
        const dot = document.createElement('button');
        dot.className = 'carrusel__dot punto';
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Ir a diapositiva ${index + 1}`);
        dot.setAttribute('aria-controls', slide.id || '');
        dot.dataset.carruselDot = String(index);
        dotsContainer.append(dot);
      });
    }

    const dots = Array.from(root.querySelectorAll<CarruselDot>('[data-carrusel-dot]'));
    const clampIndex = (index: number) => {
      if (loop) return (index + slides.length) % slides.length;
      return Math.max(0, Math.min(index, slides.length - 1));
    };

    const updateState = (index: number) => {
      activeIndex = clampIndex(index);

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.classList.toggle('activo', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle('is-active', isActive);
        dot.classList.toggle('activo', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      if (!loop) {
        if (prevButton) prevButton.disabled = activeIndex === 0 || slides.length <= 1;
        if (nextButton) nextButton.disabled = activeIndex === slides.length - 1 || slides.length <= 1;
      }
    };

    const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const nextIndex = clampIndex(index);
      const target = slides[nextIndex];
      if (!target) return;

      viewport.scrollTo({
        left: target.offsetLeft - viewport.offsetLeft,
        behavior: reducedMotion ? 'auto' : behavior,
      });
      updateState(nextIndex);
    };

    const syncFromScroll = () => {
      const nearest = slides.reduce(
        (closest, slide, index) => {
          const distance = Math.abs(slide.offsetLeft - viewport.scrollLeft);
          return distance < closest.distance ? { index, distance } : closest;
        },
        { index: activeIndex, distance: Number.POSITIVE_INFINITY }
      );
      updateState(nearest.index);
    };

    let scrollFrame = 0;
    viewport.addEventListener('scroll', () => {
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = window.requestAnimationFrame(syncFromScroll);
    }, { passive: true });

    prevButton?.addEventListener('click', () => goTo(activeIndex - 1));
    nextButton?.addEventListener('click', () => goTo(activeIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.carruselDot));
      });
    });

    const closeDialog = (dialog: CarruselDialog) => {
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    };

    imageButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.dialogTarget;
        if (!targetId) return;

        const dialog = document.getElementById(targetId) as CarruselDialog | null;
        if (!dialog) return;

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });
    });

    dialogs.forEach((dialog) => {
      dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => closeDialog(dialog));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog(dialog);
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(activeIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(activeIndex + 1);
      }

      if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      }

      if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    const stopAutoplay = () => {
      window.clearInterval(autoplayTimer);
    };

    const startAutoplay = () => {
      if (!autoplay || reducedMotion || slides.length <= 1) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(() => goTo(activeIndex + 1), interval);
    };

    root.addEventListener('pointerenter', stopAutoplay);
    root.addEventListener('pointerleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);
    window.addEventListener('resize', () => goTo(activeIndex, 'auto'));

    updateState(0);
    startAutoplay();
  };

  const bootCarruseles = () => {
    document.querySelectorAll<CarruselRoot>('[data-carrusel]').forEach(initializeCarrusel);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootCarruseles, { once: true });
  } else {
    bootCarruseles();
  }
</script>
