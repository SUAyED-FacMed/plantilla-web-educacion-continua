---
import '@/styles/acordeon.css';

interface Props {
  items: Array<{ titulo: string; contenido: string }>;
  accentColor?: string; // Color de acento personalizado
  allowMultiple?: boolean; // Permitir múltiples paneles abiertos a la vez
  openFirst?: boolean; // Abrir el primer item por defecto
}

const { items, accentColor, allowMultiple = false, openFirst = true } = Astro.props;

// Generar un ID único para este acordeón
const uniqueId = `acordeon-${Math.random().toString(36).substring(2, 9)}`;
---

<section 
  class="acordeon" 
  id={uniqueId}
  style={accentColor ? `--accent-color: ${accentColor}` : ''}
  data-allow-multiple={allowMultiple}
  data-open-first={openFirst}
>
  {items.map((item, index) => (
    <div class="acordeon__item" data-index={index}>
      <button class="acordeon__header" type="button" aria-expanded={openFirst && index === 0 ? "true" : "false"} class={openFirst && index === 0 ? "acordeon__header--active" : ""}>
        <span class="acordeon__title" set:html={item.titulo}></span>
        <span class="acordeon__icon" aria-hidden="true"></span>
      </button>
      <div class="acordeon__body" style={openFirst && index === 0 ? "max-height: fit-content" : ""}>
        <div class="acordeon__content" set:html={item.contenido} />
      </div>
    </div>
  ))}
</section>

<script is:inline>
  class AcordeonComponent {
    constructor(container) {
      this.container = container;
      this.allowMultiple = container.dataset.allowMultiple === 'true';
      this.openFirst = container.dataset.openFirst === 'true';
      this.headers = Array.from(container.querySelectorAll('.acordeon__header'));
      this.init();
    }
    
    init() {
      this.headers.forEach(header => {
        header.addEventListener('click', () => this.handleClick(header));
      });
      
      // Abrir el primer item si openFirst es true
      if (this.openFirst && this.headers.length > 0) {
        const firstHeader = this.headers[0];
        const firstBody = firstHeader.nextElementSibling;
        // Solo abrir si no está ya abierto
        if (firstHeader.getAttribute('aria-expanded') === 'true') {
          firstBody.style.maxHeight = firstBody.scrollHeight + 'px';
        }
      }
    }
    
    handleClick(clickedHeader) {
      const item = clickedHeader.parentElement;
      const body = clickedHeader.nextElementSibling;
      const isActive = clickedHeader.getAttribute('aria-expanded') === 'true';
      
      // Cerrar otros items si no se permite múltiple
      if (!this.allowMultiple) {
        this.headers.forEach(header => {
          if (header !== clickedHeader) {
            this.closeItem(header);
          }
        });
      }
      
      // Toggle el item clickeado
      if (isActive) {
        this.closeItem(clickedHeader);
      } else {
        this.openItem(clickedHeader, true);
      }
    }
    
    openItem(header, shouldScroll = false) {
      const body = header.nextElementSibling;
      header.setAttribute('aria-expanded', 'true');
      header.classList.add('acordeon__header--active');
      body.style.maxHeight = body.scrollHeight + 'px';
      
      // Hacer scroll al header cuando se abre (solo en clicks del usuario)
      if (shouldScroll) {
        setTimeout(() => {
          header.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'start',
            inline: 'nearest'
          });
        }, 100);
      }
    }
    
    closeItem(header) {
      const body = header.nextElementSibling;
      header.setAttribute('aria-expanded', 'false');
      header.classList.remove('acordeon__header--active');
      body.style.maxHeight = '0';
    }
  }
  
  // Inicializar todos los acordeones
  function initAcordeons() {
    const acordeons = document.querySelectorAll('.acordeon');
    acordeons.forEach(acordeon => {
      new AcordeonComponent(acordeon);
    });
  }
  
  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAcordeons);
  } else {
    initAcordeons();
  }
</script>

