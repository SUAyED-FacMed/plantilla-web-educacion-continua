---
interface ItemSecuencia {
  numero?: string | number;
  titulo: string;
  descripcion: string;
}

interface Props {
  items: ItemSecuencia[];
  id?: string;
  ariaLabel?: string;
}

const {
  items,
  id,
  ariaLabel = "Secuencia de claves",
} = Astro.props;
---

<div id={id} class="secuencia-claves" role="list" aria-label={ariaLabel}>
  {items.map((item, index) => (
    <div class="secuencia-claves__item" role="listitem">
      <div class="secuencia-claves__flecha" aria-hidden="true">
        <span>{item.numero ?? index + 1}</span>
      </div>
      <div class="secuencia-claves__texto">
        <h3>{item.titulo}</h3>
        <p>{item.descripcion}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .secuencia-claves {
    --secuencia-azul: #1a2c49;
    --secuencia-azul-suave: #e9f1fb;
    --secuencia-texto: #2f3e59;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 2.4rem;
    padding: 0;
    list-style: none;
  }

  .secuencia-claves__item {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0;
    color: var(--secuencia-texto);
    list-style: none;
  }

  .secuencia-claves__item::before {
    content: none;
  }

  .secuencia-claves__flecha {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    margin-bottom: 0.95rem;
    padding: 0.55rem 2rem 0.55rem 1.45rem;
    clip-path: polygon(0 0, calc(100% - 1.1rem) 0, 100% 50%, calc(100% - 1.1rem) 100%, 0 100%, 1.1rem 50%);
    background: var(--secuencia-azul-suave);
    border: 1px solid rgba(35, 79, 136, 0.24);
  }

  .secuencia-claves__item:first-child .secuencia-claves__flecha {
    clip-path: polygon(0 0, calc(100% - 1.1rem) 0, 100% 50%, calc(100% - 1.1rem) 100%, 0 100%);
  }

  .secuencia-claves__item:nth-child(2) .secuencia-claves__flecha {
    background: #dfeaf8;
  }

  .secuencia-claves__item:nth-child(3) .secuencia-claves__flecha {
    background: #f4e7ca;
    border-color: rgba(170, 118, 25, 0.28);
  }

  .secuencia-claves__flecha span {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #ffffff;
    color: var(--secuencia-azul);
    font-weight: 800;
    line-height: 1;
    box-shadow: inset 0 0 0 1px rgba(26, 44, 73, 0.16);
  }

  .secuencia-claves__texto {
    max-width: 32ch;
  }

  .secuencia-claves__texto h3 {
    margin: 0 0 0.45rem;
    color: var(--secuencia-azul);
    font-size: 1.1rem;
    font-style: normal;
    font-weight: 750;
    line-height: 1.25;
    text-wrap: balance;
  }

  .secuencia-claves__texto p {
    margin: 0;
    color: var(--secuencia-texto);
    font-size: 0.98rem;
    line-height: 1.58;
    text-wrap: pretty;
  }

  .secuencia-claves__item:nth-child(3) .secuencia-claves__texto h3 {
    color: #7d4f0f;
  }

  @media (max-width: 780px) {
    .secuencia-claves {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      margin: 1.75rem 0 2.1rem;
    }

    .secuencia-claves__item {
      display: grid;
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
    }

    .secuencia-claves__flecha,
    .secuencia-claves__item:first-child .secuencia-claves__flecha {
      min-height: 4rem;
      margin: 0;
      padding: 0.5rem;
      clip-path: none;
      border-radius: 8px;
    }

    .secuencia-claves__texto {
      max-width: 100%;
    }

    .secuencia-claves__texto h3 {
      font-size: 1.04rem;
    }
  }

  @media (max-width: 430px) {
    .secuencia-claves__item {
      grid-template-columns: 3.4rem minmax(0, 1fr);
      column-gap: 0.8rem;
    }

    .secuencia-claves__flecha {
      min-height: 3.4rem;
    }

    .secuencia-claves__flecha span {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
</style>
