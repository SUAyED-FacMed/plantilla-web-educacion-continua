---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@/styles/tarjetas-giratorias.css';

type VarianteTarjeta = 'carta1' | 'carta2' | 'carta3' | 'carta4' | 'azul' | 'dorado' | 'neutra';
type ImagenTarjeta = ImageMetadata | string;

interface CaraTarjeta {
  titulo?: string;
  subtitulo?: string;
  texto?: string;
  contenido?: string;
  imagen?: ImagenTarjeta;
  alt?: string;
  pie?: string;
}

interface TarjetaGiratoria {
  id?: string;
  variante?: VarianteTarjeta;
  frente: CaraTarjeta;
  vuelta: CaraTarjeta;
}

interface Props {
  id?: string;
  tarjetas: TarjetaGiratoria[];
  class?: string;
}

const { id, tarjetas, class: className = '' } = Astro.props;
const uid = id ?? `tarjetas-giratorias-${Math.random().toString(36).slice(2, 9)}`;
---

<section class:list={['tarjetas-giratorias', className]} id={uid}>
  {tarjetas.map((tarjeta, index) => {
    const inputId = `${uid}-tarjeta-${tarjeta.id ?? index}`;
    const variante = tarjeta.variante ?? 'carta1';
    const tituloAccesible = tarjeta.frente.titulo ?? `Tarjeta ${index + 1}`;

    return (
      <div class="tg-card-wrap">
        <input
          class="tg-card__toggle"
          id={inputId}
          type="checkbox"
          aria-label={`Girar tarjeta: ${tituloAccesible}`}
        />
        <article class={`tg-card tg-card--${variante}`}>
          <div class="tg-card__inner">
            <div class="tg-card__face tg-card__face--front">
              <div class="tg-card__body">
                {tarjeta.frente.subtitulo && <p class="tg-card__eyebrow">{tarjeta.frente.subtitulo}</p>}
                {tarjeta.frente.titulo && <h3 class="tg-card__title">{tarjeta.frente.titulo}</h3>}
                {tarjeta.frente.imagen && (
                  <figure class="tg-card__figure">
                    {typeof tarjeta.frente.imagen === 'string' ? (
                      <img src={tarjeta.frente.imagen} alt={tarjeta.frente.alt ?? ''} loading="lazy" />
                    ) : (
                      <Image
                        src={tarjeta.frente.imagen}
                        alt={tarjeta.frente.alt ?? ''}
                        widths={[240, 360, 520]}
                        sizes="(max-width: 640px) 70vw, 260px"
                      />
                    )}
                    {tarjeta.frente.pie && <figcaption set:html={tarjeta.frente.pie} />}
                  </figure>
                )}
                {tarjeta.frente.texto && <p>{tarjeta.frente.texto}</p>}
                {tarjeta.frente.contenido && <div set:html={tarjeta.frente.contenido} />}
              </div>
              <label class="tg-card__control" for={inputId}>
                <svg class="tg-card__control-icon" aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                  <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                  <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
                </svg>
                <span>Girar</span>
              </label>
            </div>

            <div class="tg-card__face tg-card__face--back">
              <div class="tg-card__body">
                {tarjeta.vuelta.subtitulo && <p class="tg-card__eyebrow">{tarjeta.vuelta.subtitulo}</p>}
                {tarjeta.vuelta.titulo && <h3 class="tg-card__title">{tarjeta.vuelta.titulo}</h3>}
                {tarjeta.vuelta.imagen && (
                  <figure class="tg-card__figure">
                    {typeof tarjeta.vuelta.imagen === 'string' ? (
                      <img src={tarjeta.vuelta.imagen} alt={tarjeta.vuelta.alt ?? ''} loading="lazy" />
                    ) : (
                      <Image
                        src={tarjeta.vuelta.imagen}
                        alt={tarjeta.vuelta.alt ?? ''}
                        widths={[240, 360, 520]}
                        sizes="(max-width: 640px) 70vw, 260px"
                      />
                    )}
                    {tarjeta.vuelta.pie && <figcaption set:html={tarjeta.vuelta.pie} />}
                  </figure>
                )}
                {tarjeta.vuelta.texto && <p>{tarjeta.vuelta.texto}</p>}
                {tarjeta.vuelta.contenido && <div set:html={tarjeta.vuelta.contenido} />}
              </div>
              <label class="tg-card__control tg-card__control--back" for={inputId}>
                <svg class="tg-card__control-icon" aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                  <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                  <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
                </svg>
                <span>Frente</span>
              </label>
            </div>
          </div>
        </article>
      </div>
    );
  })}
</section>
