---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  pie?: string;
  invertir?: boolean; // true = imagen a la derecha, false = imagen a la izquierda
}

const { src, alt, title, pie, invertir = false } = Astro.props;
---

<!--imagen clip  -->
<article class="fondo--Unidad my-3">
  <div class={`row p-3 container mx-auto d-flex align-items-end ${invertir ? 'flex-row-reverse' : ''}`}>
    <div class="col-md-9 my-3">
      <Image
        src={src}
        alt={alt}
        title={title}
        class="img-fluid d-block mx-auto clip img-thumbnail"
        widths={[400, 600, 800, 1200]}
        sizes="(max-width: 768px) 100vw, (max-width: 992px) 90vw, 75vw"
      />
    </div>
    {pie && (
      <div class="col-md-3">
        <p class="small text-center py-3 subtitulosA">
          <Fragment set:html={pie} />
        </p>
      </div>
    )}
  </div>
</article>
<!-- imagen clip -->
