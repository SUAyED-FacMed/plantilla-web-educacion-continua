---
export interface Props {
  nombreCurso?: string;
  unidad?: string;
  recurso?: string;
}

import { siteConfig } from "@/config";
import { Image } from "astro:assets";

export let nombreCurso: string = "";
export let unidad: string = "";
export let recurso: string = "";
const autores = siteConfig.autores ?? [];
if (!nombreCurso) nombreCurso = siteConfig.nombreCurso ?? "";
if (!unidad) unidad = siteConfig.unidad ?? "";
if (!recurso) recurso = siteConfig.recurso ?? "";
import cornisa from "@assets/img/cornisa.png";
import unamImg from "@assets/img/unam.png";
import facmedImg from "@assets/img/facmed.png";
import suayedImg from "@assets/img/suayed.png";
import ec1Img from "@assets/img/ec1.png";
import secyssImg from "@assets/img/secyss.png";
import ingFacmedImg from "@assets/img/ingFacmed.png";
---

<!-- unidad titulo -->
<article class="container fondo-libro">
  <!-- Cornisa + Logos: flex row on md+, stacked on mobile -->
  <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
    <!-- Cornisa (left on desktop, top on mobile) -->
    <div class="w-full md:w-auto md:shrink-0">
      <Image 
        class="w-full h-auto object-cover max-h-[70px] md:max-h-[120px]" 
        src={cornisa} 
        alt="" 
      />
    </div>
    
    <!-- Logos (right on desktop, bottom on mobile) -->
    <div class="flex flex-wrap justify-center md:justify-start gap-3 md:gap-4">
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={unamImg} alt="UNAM" />
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={facmedImg} alt="FacMed" />
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={suayedImg} alt="SUAYED" />
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={ec1Img} alt="EC1" />
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={secyssImg} alt="SecySS" />
      <Image class="h-auto w-16 sm:w-20 md:w-24 lg:w-28" src={ingFacmedImg} alt="IngFacMed" />
    </div>
  </div>
  <div class="px-3 py-2 mt-5 align-items-center unidadC gradient-unidad">
    <p class="gap-3 font-weight-bold">
      {nombreCurso}
      <br />
      {unidad}
    </p>
  </div>
  <div class="separacion"></div>

  <div class="ml-5 py-2 mt-5 align-items-center unidadC">
    <h1 class="px-3 font-weight-bold fsize">
      {recurso}
    </h1>
    <p class="px-3 mt-2 subtitulos font-weight-normal">
      {
        autores.map((a) => (
          <span>
            {a}
            <br />
          </span>
        ))
      }
    </p>
  </div>
  <div class="separacion"></div>
  <div class="separacion"></div>
  <div class="separacion"></div>
</article>
<!-- fin unidad titulo -->

<article>
  <div class="degradado-gris2">
    <div class="py-4"></div>
  </div>
  <div class="degradado-bottom"></div>
</article>
</attachment>


