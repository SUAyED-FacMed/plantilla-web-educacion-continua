---
import type { Autor, LogoVisibility } from "@/config/site";

export interface Props {
  licenciatura?: string;
  nombreCurso?: string;
  unidad?: string;
  recurso?: string;
  autores?: Autor[];
  logoVisibility?: LogoVisibility;
}

import { siteConfig } from "@/config";
import { Image } from "astro:assets";

// Primero extraemos las props, luego aplicamos defaults
const props = Astro.props;
const licenciatura = props.licenciatura ?? siteConfig.licenciatura ?? "";
const nombreCurso = props.nombreCurso ?? siteConfig.nombreCurso ?? "";
const unidad = props.unidad ?? siteConfig.unidad ?? "";
const recurso = props.recurso ?? siteConfig.recurso ?? "";
const autores = props.autores ?? siteConfig.autores ?? [];
const logoVisibility = props.logoVisibility ?? siteConfig.logoVisibility ?? {};

const isLogoVisible = (key: keyof LogoVisibility) => logoVisibility[key] ?? true;

import cornisa from "@assets/img/cornisa.png";
import unamImg from "@assets/img/unam.png";
import facmedImg from "@assets/img/facmed.png";
import suayedImg from "@assets/img/suayed.png";
import ec1Img from "@assets/img/ec1.png";
import secyssImg from "@assets/img/seciss-logo.png";
---

<!-- unidad titulo -->
<article class="max-w-6xl mx-auto fondo-libro">
  <!-- Cornisa + Logos: flex row on md+, stacked on mobile -->
  <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
    <!-- Cornisa (left on desktop, top on mobile) -->
    <div class="w-full md:w-1/5 bg- md:shrink-0 self-start">
      <Image class="h-full md:w-full object-cover" src={cornisa} alt="Pleca corinsa" />
    </div>

    <!-- Logos (right on desktop, bottom on mobile) -->
    <div class="hero-logos md:flex-1" aria-label="Identidad institucional">
      {isLogoVisible("unam") && (
        <Image class="hero-logo hero-logo--seal" src={unamImg} alt="UNAM" />
      )}
      {isLogoVisible("facmed") && (
        <Image class="hero-logo hero-logo--seal" src={facmedImg} alt="Facultad de Medicina" />
      )}
      {isLogoVisible("suayed") && (
        <Image class="hero-logo hero-logo--wide" src={suayedImg} alt="SUAyED" />
      )}
      {isLogoVisible("seciss") && (
        <Image class="hero-logo hero-logo--wordmark" src={secyssImg} alt="SECISS" />
      )}
      {isLogoVisible("educacionContinua") && (
        <Image class="hero-logo hero-logo--wide" src={ec1Img} alt="Educación Continua" />
      )}
    </div>
  </div>
  <div class="px-3 py-3 mt-5 align-items-center unidadC gradient-unidad">
    <p class="mb-1  leading-snug font-bold">
      <Fragment set:html={licenciatura} />
    </p>
    <p class="lg:text-xl mb-1 font-bold leading-snug">
      <Fragment set:html={nombreCurso} />
    </p>
    <p class="pt-0 leading-relaxed font-bold">
      <Fragment set:html={unidad} />
    </p>
  </div>
  <div class="separacion"></div>

  <div class="ml-5 py-3 mt-5 align-items-center unidadC">
    <h1 class="px-3 font-bold leading-tight mb-3">
      <Fragment set:html={recurso} />
    </h1>
    <p class="px-3 mt-2 subtitulos text-base md:text-lg font-normal leading-relaxed">
      {
        autores.map((a) => (
          <span>
            {a.nombres} {a.apellidos}
            <br />
          </span>
        ))
      }
    </p>
  </div>
  <div class="separacion"></div>
  <div class="separacion"></div>
  <div class="separacion"></div>
</article>
<!-- fin unidad titulo -->

<article class="mb-10">
  <div class="degradado-gris2">
    <div class="py-4"></div>
  </div>
  <div class="degradado-bottom"></div>
</article>

<style>
  .hero-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.65rem;
  }

  .hero-logo {
    display: block;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1) opacity(0.82);
  }

  .hero-logo--seal {
    height: 3rem;
  }

  .hero-logo--wordmark {
    height: 2.15rem;
  }

  .hero-logo--wide {
    height: 2.55rem;
  }

  @media (max-width: 640px) {
    .hero-logos {
      gap: 0.85rem 1.15rem;
    }

    .hero-logo--seal {
      height: 2.65rem;
    }

    .hero-logo--wordmark,
    .hero-logo--wide {
      height: 2.15rem;
    }
  }
</style>
