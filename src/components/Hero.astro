---
import type { Autor } from "@/config/site";

export interface Props {
  nombreCurso?: string;
  unidad?: string;
  recurso?: string;
  autores?: Autor[];
}

import { siteConfig } from "@/config";
import { Image } from "astro:assets";

const { 
  nombreCurso = siteConfig.nombreCurso ?? "",
  unidad = siteConfig.unidad ?? "",
  recurso = siteConfig.recurso ?? "",
  autores = siteConfig.autores ?? []
} = Astro.props;

import cornisa from "@assets/img/cornisa.png";
import unamImg from "@assets/img/unam.png";
import facmedImg from "@assets/img/facmed.png";
import suayedImg from "@assets/img/suayed.png";
import ec1Img from "@assets/img/ec1.png";
import secyssImg from "@assets/img/secyss.png";
---

<!-- unidad titulo -->
<article class="max-w-6xl mx-auto fondo-libro">
  <!-- Cornisa + Logos: flex row on md+, stacked on mobile -->
  <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
    <!-- Cornisa (left on desktop, top on mobile) -->
    <div class="w-full md:w-1/5 bg- md:shrink-0 self-start">
      <Image class="h-full md:w-full object-cover" src={cornisa} alt="Pleca corinsa" />
    </div>

    <!-- Logos (right on desktop, bottom on mobile) -->
    <div
      class="flex flex-wrap flex-row align-center md:flex-1 gap-4"
      >
      <Image class="max-h-12 w-auto" src={unamImg} alt="UNAM" />
      <Image class="max-h-12 w-auto" src={facmedImg} alt="FacMed" />
      <Image class="max-h-12 w-auto" src={suayedImg} alt="SUAYED" />
      <Image class="max-h-12 w-auto" src={secyssImg} alt="SecySS" />
      <Image class="max-h-12 w-auto" src={ec1Img} alt="EC1" />
    </div>
  </div>
  <div class="px-3 py-3 mt-5 align-items-center unidadC gradient-unidad">
    <p class="text-base md:text-lg lg:text-xl mb-1 font-medium leading-snug">
      <Fragment set:html={nombreCurso} />
    </p>
    <p class="text-sm md:text-base lg:text-lg pt-0 leading-relaxed">
      <Fragment set:html={unidad} />
    </p>
  </div>
  <div class="separacion"></div>

  <div class="ml-5 py-3 mt-5 align-items-center unidadC">
    <h1 class="px-3 text-2xl md:text-3xl lg:text-4xl font-bold leading-tight mb-3">
      <Fragment set:html={recurso} />
    </h1>
    <p class="px-3 mt-2 subtitulos text-base md:text-lg font-normal leading-relaxed">
      {
        autores.map((a) => (
          <span>
            {a.nombres} {a.apellidos}
            <br />
          </span>
        ))
      }
    </p>
  </div>
  <div class="separacion"></div>
  <div class="separacion"></div>
  <div class="separacion"></div>
</article>
<!-- fin unidad titulo -->

<article class="mb-10">
  <div class="degradado-gris2">
    <div class="py-4"></div>
  </div>
  <div class="degradado-bottom"></div>
</article>
