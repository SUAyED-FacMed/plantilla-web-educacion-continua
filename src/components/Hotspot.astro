---
import { Image } from 'astro:assets';
import type { ConfigHotspot, PuntoHotspot } from '@/config/hotspots';

interface Props {
  config: ConfigHotspot;
  ancho?: string;
  alto?: string;
  class?: string;
}

const { config, ancho, alto, class: className = '' } = Astro.props;
const { id, imagen, altImagen, puntos } = config;

// Construir clases de Tailwind para dimensiones
const dimensionClasses = [
  ancho || '',
  alto || '',
  className
].filter(Boolean).join(' ');
---

<!-- hotspot -->
<section class={`hotspot mb-5 ${dimensionClasses}`} id={id}>
  <div class="container">
    <Image
      src={imagen}
      alt={altImagen}
      widths={[400, 600, 800]}
      sizes="(max-width: 768px) 80vw, 650px"
    />
    <div class="all-tooltip">
      {puntos.map((punto) => {
        const tooltipContent = `<h1>${punto.titulo}</h1>${punto.contenido}`;
        return (
          <div class="hotspot-point" data-tooltip-id={punto.id}>
            <div
              tabindex={punto.id}
              class="pin"
              data-bs-toggle="tooltip"
              data-bs-placement={punto.placement || 'top'}
              data-bs-custom-class="custom-tooltip"
              data-bs-html="true"
              style={`top: ${punto.top}; left: ${punto.left};`}
              set:html={`<span style="display:none" data-tooltip-content>${tooltipContent}</span>`}
            >
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<link rel="stylesheet" href="/src/styles/hotspot.css" />

<script define:vars={{ id }}>
  // Inicializar tooltips de Bootstrap para este hotspot
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof bootstrap !== 'undefined') {
      const hotspot = document.querySelector(`section.hotspot#${id}`);
      if (hotspot) {
        const pins = hotspot.querySelectorAll('.pin[data-bs-toggle="tooltip"]');
        pins.forEach(pin => {
          // Obtener el contenido del tooltip desde el elemento oculto
          const contentSpan = pin.querySelector('[data-tooltip-content]');
          if (contentSpan) {
            pin.setAttribute('data-bs-title', contentSpan.innerHTML);
          }
          // Inicializar el tooltip
          new bootstrap.Tooltip(pin);
        });
      }
    }
  });
</script>
<!-- fin hotspot -->
