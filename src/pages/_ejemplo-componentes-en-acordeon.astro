---
import Layout from '@/layouts/Layout.astro';
import Acordeon from '@/components/Acordeon.astro';
import Tabs from '@/components/Tabs.astro';
import Imagen from '@/components/Imagen.astro';
import Carrusel from '@/components/Carrusel.astro';
import '@/styles/tablas.css';

// Importar imágenes de ejemplo (ajusta las rutas según tus recursos)
import imgEjemplo from '@/assets/img/diabetes.jpg';
---

<Layout titulo="Componentes dentro de Acordeon y Tabs">
  <main style="padding: 2rem;">
    <h1>Usar Componentes dentro de Acordeon y Tabs</h1>
    <p style="margin-bottom: 2rem; color: #6c757d;">
      Ahora puedes usar cualquier componente de Astro dentro del contenido de Tabs y Acordeon usando slots.
    </p>

    <section style="margin-bottom: 4rem;">
      <h2>Ejemplo 1: Acordeon Médico Completo (5 items con slots)</h2>
      <p style="color: #6c757d; margin-bottom: 1rem;">
        Ejemplo real: Complicaciones de tuberculosis con múltiples desplegables
      </p>
      
      <Acordeon 
        items={[
          { titulo: 'Hemoptisis masiva' },
          { titulo: 'Neumotórax espontáneo' },
          { titulo: 'Bronquiectasias y obstrucción' },
          { titulo: 'Aspergilosis pulmonar crónica' },
          { titulo: 'Insuficiencia respiratoria' }
        ]}
      >
        {/* Item 0: Hemoptisis */}
        <Fragment slot="item-0">
          <ul>
            <li><strong>Mecanismo:</strong> Ocurre principalmente por la erosión de arterias bronquiales hipertrofiadas que irrigan las paredes de las cavidades tuberculosas.</li>
            <li><strong>Definición de gravedad:</strong> Se considera masiva con un volumen >200 mL en 24 horas o si existe compromiso hemodinámico o respiratorio.</li>
            <li><strong>Manejo inmediato:</strong></li>
            <ul>
              <li>Estabilización: Posición lateral sobre el pulmón afectado, protección de la vía aérea y oxigenoterapia de alto flujo.</li>
              <li>Traslado urgente para intervención definitiva: Broncoscopia —para localización y taponamiento— o embolización arterial —tratamiento de elección—.</li>
            </ul>
            <li><strong>Pronóstico:</strong> La embolización controla el sangrado agudo en un 85-90 % de los casos, pero la tasa de recurrencia es del 10-25 % a los dos años.</li>
          </ul>
          
          <Imagen
            src={imgEjemplo}
            alt="Esquema de manejo de hemoptisis masiva"
          />
        </Fragment>

        {/* Item 1: Neumotórax */}
        <Fragment slot="item-1">
          <p><strong>Neumotórax espontáneo</strong> asociado a tuberculosis pulmonar activa.</p>
          
          <ul>
            <li><strong>Fisiopatología:</strong> Ruptura de cavidad tuberculosa subpleural hacia el espacio pleural.</li>
            <li><strong>Incidencia:</strong> Ocurre en 1-2% de personas adultas con TB activa.</li>
            <li><strong>Manifestaciones clínicas:</strong></li>
            <ul>
              <li>Dolor torácico súbito ipsilateral</li>
              <li>Disnea de inicio agudo</li>
              <li>Disminución de ruidos respiratorios</li>
            </ul>
            <li><strong>Tratamiento:</strong> Drenaje torácico urgente + tratamiento antituberculoso estándar.</li>
          </ul>
          
          <Imagen
            src={imgEjemplo}
            alt="Radiografía de neumotórax en tuberculosis"
          />
        </Fragment>

        {/* Item 2: Bronquiectasias */}
        <Fragment slot="item-2">
          <h4 style="margin-top: 0;">Bronquiectasias post-tuberculosis</h4>
          
          <p>Dilatación irreversible de los bronquios como secuela de TB curada.</p>
          
          <div class="tabla-container">
            <table class="tabla-moderna tabla-compacta">
              <thead>
                <tr>
                  <th>Aspecto</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Prevalencia</strong></td>
                  <td>Hasta 50% de pacientes curados presentan algún grado de PTLD</td>
                </tr>
                <tr>
                  <td><strong>Mecanismo</strong></td>
                  <td>Remodelado bronquial y destrucción del parénquima pulmonar</td>
                </tr>
                <tr>
                  <td><strong>Síntomas</strong></td>
                  <td>Tos crónica productiva, disnea de esfuerzo, infecciones recurrentes</td>
                </tr>
                <tr>
                  <td><strong>Seguimiento</strong></td>
                  <td>Espirometría anual, cultivos si hay exacerbaciones</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Imagen
            src={imgEjemplo}
            alt="TAC de bronquiectasias post-TB"
          />
        </Fragment>

        {/* Item 3: Aspergilosis */}
        <Fragment slot="item-3">
          <h4 style="margin-top: 0;">Aspergilosis Pulmonar Crónica (APC)</h4>
          
          <p>Colonización por <em>Aspergillus</em> de cavidades residuales post-tuberculosis.</p>
          
          <ul>
            <li><strong>Epidemiología:</strong> Prevalece en ≈9% de pacientes durante o después del tratamiento anti-TB.</li>
            <li><strong>Factores de riesgo:</strong></li>
            <ul>
              <li>Cavidades >2 cm</li>
              <li>Múltiples cavidades</li>
              <li>Inmunosupresión</li>
              <li>EPOC coexistente</li>
            </ul>
            <li><strong>Diagnóstico:</strong> Imagen (aspergiloma en cavidad), serología positiva, cultivo de esputo.</li>
            <li><strong>Tratamiento:</strong> Antifúngicos (itraconazol, voriconazol) o cirugía en casos seleccionados.</li>
          </ul>
          
          <Imagen
            src={imgEjemplo}
            alt="Aspergiloma en cavidad tuberculosa"
          />
          
          <p style="margin-top: 1rem; padding: 1rem; background: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px;">
            ⚠️ <strong>Nota clínica:</strong> El aspergiloma puede causar hemoptisis recurrente y requiere seguimiento estrecho.
          </p>
        </Fragment>

        {/* Item 4: Insuficiencia respiratoria */}
        <Fragment slot="item-4">
          <h4 style="margin-top: 0;">Insuficiencia Respiratoria y SDRA</h4>
          
          <p>Complicación grave de TB diseminada o formas extensas de TB pulmonar.</p>
          
          <Carrusel 
            id="carrusel-ir"
            slides={[
              { id: 1, imagen: imgEjemplo, alt: 'Radiografía: infiltrados difusos', title: 'Radiografía', pie: 'Infiltrados difusos bilaterales' },
              { id: 2, imagen: imgEjemplo, alt: 'TAC: opacidades en vidrio esmerilado', title: 'TAC de tórax', pie: 'Opacidades en vidrio esmerilado' },
              { id: 3, imagen: imgEjemplo, alt: 'Evolución con tratamiento', title: 'Seguimiento', pie: 'Evolución favorable con tratamiento' }
            ]}
          />
          
          <ul style="margin-top: 1.5rem;">
            <li><strong>Mecanismo:</strong> Diseminación hematógena aguda, neumonitis extensa, SDRA.</li>
            <li><strong>Criterios de SDRA:</strong></li>
            <ul>
              <li>
              <li>No explicado por falla cardíaca</li>
            </ul>
            <li><strong>Manejo:</strong> UCI, ventilación mecánica protectora, tratamiento anti-TB inmediato, considerar corticoides.</li>
            <li><strong>Pronóstico:</strong> Mortalidad 30-50% dependiendo de severidad y comorbilidades.</li>
          </ul>
        </Fragment>
      </Acordeon>
    </section>

    <section style="margin-bottom: 4rem;">
      <h2>Ejemplo 2: Tabs con 4 Pestañas (slots)</h2>
      <p style="color: #6c757d; margin-bottom: 1rem;">
        Ejemplo: Proceso diagnóstico y terapéutico de tuberculosis
      </p>
      
      <Tabs 
        id="tabs-tb-completo"
        items={[
          { titulo: 'Diagnóstico' },
          { titulo: 'Tratamiento' },
          { titulo: 'Seguimiento' },
          { titulo: 'Complicaciones' }
        ]}
      >
        {/* Tab 0: Diagnóstico */}
        <Fragment slot="item-0">
          <h3>Métodos Diagnósticos para Tuberculosis</h3>
          
          <div class="tabla-container">
            <table class="tabla-moderna">
              <thead>
                <tr>
                  <th>Método</th>
                  <th>Sensibilidad</th>
                  <th>Especificidad</th>
                  <th>Tiempo de resultado</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Baciloscopía</strong></td>
                  <td>50-80%</td>
                  <td>95-98%</td>
                  <td>1-2 horas</td>
                </tr>
                <tr>
                  <td><strong>Cultivo (Löwenstein-Jensen)</strong></td>
                  <td>80-90%</td>
                  <td>98-100%</td>
                  <td>2-8 semanas</td>
                </tr>
                <tr>
                  <td><strong>GeneXpert MTB/RIF</strong></td>
                  <td>88-98%</td>
                  <td>98-99%</td>
                  <td>2 horas</td>
                </tr>
                <tr>
                  <td><strong>Cultivo líquido (MGIT)</strong></td>
                  <td>85-95%</td>
                  <td>98-100%</td>
                  <td>1-3 semanas</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Imagen
            src={imgEjemplo}
            alt="Algoritmo diagnóstico de tuberculosis"
          />
          
          <p style="margin-top: 1rem;">
            <strong>Recomendación OMS:</strong> GeneXpert como prueba inicial en pacientes con sospecha de TB o TB resistente.
          </p>
        </Fragment>

        {/* Tab 1: Tratamiento */}
        <Fragment slot="item-1">
          <h3>Esquema de Tratamiento Estándar</h3>
          
          <p>Terapia para tuberculosis sensible a fármacos de primera línea:</p>
          
          <div class="tabla-container">
            <table class="tabla-moderna">
              <thead>
                <tr>
                  <th>Fase</th>
                  <th>Medicamentos</th>
                  <th>Duración</th>
                  <th>Observaciones</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Inicial (Intensiva)</strong></td>
                  <td>
                    Isoniazida (H)<br>
                    Rifampicina (R)<br>
                    Pirazinamida (Z)<br>
                    Etambutol (E)
                  </td>
                  <td>2 meses</td>
                  <td>Administración diaria supervisada (TAES)</td>
                </tr>
                <tr>
                  <td><strong>Continuación</strong></td>
                  <td>
                    Isoniazida (H)<br>
                    Rifampicina (R)
                  </td>
                  <td>4 meses</td>
                  <td>Puede ser diaria o tres veces por semana</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Imagen
            src={imgEjemplo}
            alt="Esquema visual del tratamiento"
          />
          
          <ul style="margin-top: 1.5rem;">
            <li><strong>Dosis de Isoniazida:</strong> 5 mg/kg/día (máx. 300 mg/día)</li>
            <li><strong>Dosis de Rifampicina:</strong> 10 mg/kg/día (máx. 600 mg/día)</li>
            <li><strong>Dosis de Pirazinamida:</strong> 25 mg/kg/día (máx. 2000 mg/día)</li>
            <li><strong>Dosis de Etambutol:</strong> 15 mg/kg/día (máx. 1600 mg/día)</li>
          </ul>
          
          <p style="margin-top: 1rem; padding: 1rem; background: #d1ecf1; border-left: 4px solid #0c5460; border-radius: 4px;">
            ℹ️ <strong>Importante:</strong> Agregar vitamina B6 (piridoxina) 25-50 mg/día para prevenir neuropatía periférica por isoniazida.
          </p>
        </Fragment>

        {/* Tab 2: Seguimiento */}
        <Fragment slot="item-2">
          <h3>Monitoreo Durante el Tratamiento</h3>
          
          <p>Evaluaciones periódicas para asegurar eficacia y detectar efectos adversos:</p>
          
          <div class="tabla-container">
            <table class="tabla-moderna tabla-compacta">
              <thead>
                <tr>
                  <th>Tiempo</th>
                  <th>Evaluación clínica</th>
                  <th>Baciloscopía/cultivo</th>
                  <th>Laboratorio</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Basal</strong></td>
                  <td>Peso, síntomas, examen físico</td>
                  <td>Baciloscopía + cultivo</td>
                  <td>BH, QS, PFH, HIV, agudeza visual</td>
                </tr>
                <tr>
                  <td><strong>Mes 1</strong></td>
                  <td>Peso, adherencia, síntomas</td>
                  <td>No rutinario</td>
                  <td>PFH si síntomas sugestivos</td>
                </tr>
                <tr>
                  <td><strong>Mes 2</strong></td>
                  <td>Peso, tolerancia</td>
                  <td>Baciloscopía + cultivo</td>
                  <td>BH, QS, PFH</td>
                </tr>
                <tr>
                  <td><strong>Mes 5</strong></td>
                  <td>Peso, adherencia</td>
                  <td>Baciloscopía</td>
                  <td>QS, PFH</td>
                </tr>
                <tr>
                  <td><strong>Fin (mes 6)</strong></td>
                  <td>Peso, evaluación final</td>
                  <td>Baciloscopía + cultivo</td>
                  <td>BH, QS, PFH, Rx tórax</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Carrusel 
            id="carrusel-seguimiento"
            slides={[
              { id: 1, imagen: imgEjemplo, alt: 'Radiografía basal', title: 'Radiografía inicial', pie: 'Infiltrados extensos bilaterales' },
              { id: 2, imagen: imgEjemplo, alt: 'Radiografía mes 2', title: 'Mes 2 de tratamiento', pie: 'Mejoría parcial de infiltrados' },
              { id: 3, imagen: imgEjemplo, alt: 'Radiografía final', title: 'Fin del tratamiento', pie: 'Resolución de lesiones activas' }
            ]}
          />
          
          <h4 style="margin-top: 2rem;">Criterios de Curación</h4>
          <ul>
            <li>Baciloscopía negativa en mes 5 y 6</li>
            <li>Cultivo negativo al finalizar tratamiento</li>
            <li>Mejoría clínica y radiológica</li>
            <li>Completar 6 meses de tratamiento supervisado</li>
          </ul>
        </Fragment>

        {/* Tab 3: Complicaciones */}
        <Fragment slot="item-3">
          <h3>Complicaciones del Tratamiento</h3>
          
          <p>Efectos adversos más comunes de los fármacos antituberculosos:</p>
          
          <div class="tabla-container">
            <table class="tabla-moderna">
              <thead>
                <tr>
                  <th>Fármaco</th>
                  <th>Efecto adverso</th>
                  <th>Frecuencia</th>
                  <th>Manejo</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Isoniazida</strong></td>
                  <td>Hepatotoxicidad</td>
                  <td>10-20%</td>
                  <td>Suspender si ALT >3x con síntomas o >5x asintomático</td>
                </tr>
                <tr>
                  <td><strong>Isoniazida</strong></td>
                  <td>Neuropatía periférica</td>
                  <td>2-20%</td>
                  <td>Piridoxina 25-50 mg/día profiláctica</td>
                </tr>
                <tr>
                  <td><strong>Rifampicina</strong></td>
                  <td>Hepatotoxicidad</td>
                  <td>8-15%</td>
                  <td>Monitoreo de PFH, suspender si es grave</td>
                </tr>
                <tr>
                  <td><strong>Rifampicina</strong></td>
                  <td>Interacciones medicamentosas</td>
                  <td>Frecuente</td>
                  <td>Revisar todas las medicaciones del paciente</td>
                </tr>
                <tr>
                  <td><strong>Pirazinamida</strong></td>
                  <td>Hepatotoxicidad</td>
                  <td>5-15%</td>
                  <td>Suspender si hepatitis clínica</td>
                </tr>
                <tr>
                  <td><strong>Pirazinamida</strong></td>
                  <td>Hiperuricemia/gota</td>
                  <td>15-30%</td>
                  <td>Alopurinol si es sintomática</td>
                </tr>
                <tr>
                  <td><strong>Etambutol</strong></td>
                  <td>Neuritis óptica</td>
                  <td>1-5%</td>
                  <td>Suspender inmediatamente, usualmente reversible</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Imagen
            src={imgEjemplo}
            alt="Algoritmo de manejo de hepatotoxicidad"
          />
          
          <div style="margin-top: 1.5rem; padding: 1rem; background: #f8d7da; border-left: 4px solid #dc3545; border-radius: 4px;">
            <h4 style="margin-top: 0; color: #721c24;">⚠️ Signos de Alarma</h4>
            <ul style="margin-bottom: 0;">
              <li>Ictericia o coluria</li>
              <li>Náusea persistente y vómito</li>
              <li>Dolor abdominal</li>
              <li>Cambios visuales (visión borrosa, discromatopsia)</li>
              <li>Parestesias o debilidad en extremidades</li>
              <li>Rash cutáneo extenso</li>
            </ul>
          </div>
        </Fragment>
      </Tabs>
    </section>

    <section style="margin-bottom: 4rem;">
      <h2>Ejemplo 3: Acordeon Mixto (Slots + HTML)</h2>
      <p style="color: #6c757d; margin-bottom: 1rem;">
        Combina items con componentes (slots) e items con HTML simple
      </p>
      
      <Acordeon 
        allowMultiple={true}
        items={[
          { titulo: 'Item con componentes (slot)' },
          { 
            titulo: 'Item con HTML tradicional',
            contenido: '<p>Este es <strong>contenido HTML simple</strong> sin componentes.</p><p>Útil para texto básico sin imágenes o tablas complejas.</p><ul><li>Punto 1</li><li>Punto 2</li><li>Punto 3</li></ul>'
          },
          { titulo: 'Otro item con componentes' },
          {
            titulo: 'Más HTML simple',
            contenido: '<p><em>Puedes mezclar ambos modos</em> según necesites.</p>'
          }
        ]}
      >
        <Fragment slot="item-0">
          <p>Este item contiene componentes:</p>
          <Imagen
            src={imgEjemplo}
            alt="Imagen en acordeon"
          />
          <p style="margin-top: 1rem;">✅ Renderizado con slot</p>
        </Fragment>

        <Fragment slot="item-2">
          <h4 style="margin-top: 0;">Tabla de datos</h4>
          <div class="tabla-container">
            <table class="tabla-moderna tabla-compacta">
              <thead>
                <tr>
                  <th>Parámetro</th>
                  <th>Valor normal</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>FEV1</strong></td>
                  <td>>80% del predicho</td>
                </tr>
                <tr>
                  <td><strong>FVC</strong></td>
                  <td>>80% del predicho</td>
                </tr>
              </tbody>
            </table>
          </div>
          <Imagen
            src={imgEjemplo}
            alt="Espirometría"
          />
        </Fragment>
      </Acordeon>
    </section>

    <section style="margin-bottom: 4rem;">
      <h2>Ejemplo 4: Tabs con Nombres de Slot Personalizados</h2>
      
      <Tabs 
        id="tabs-componentes"
        items={[
          { titulo: 'Diagnóstico' },
          { titulo: 'Tratamiento' },
          { titulo: 'Imágenes', slotName: 'imagenes-tab' }
        ]}
      >
        <Fragment slot="item-0">
          <h3>Métodos Diagnósticos</h3>
          
          <div class="tabla-container">
            <table class="tabla-moderna">
              <thead>
                <tr>
                  <th>Método</th>
                  <th>Sensibilidad</th>
                  <th>Tiempo</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Baciloscopía</strong></td>
                  <td>50-80%</td>
                  <td>1-2 horas</td>
                </tr>
                <tr>
                  <td><strong>Cultivo</strong></td>
                  <td>80-90%</td>
                  <td>2-8 semanas</td>
                </tr>
                <tr>
                  <td><strong>GeneXpert</strong></td>
                  <td>88-98%</td>
                  <td>2 horas</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <Imagen
            src={imgEjemplo}
            alt="Algoritmo diagnóstico"
          />
        </Fragment>

        <Fragment slot="item-1">
          <h3>Esquema de Tratamiento</h3>
          <p>Terapia para tuberculosis sensible a fármacos:</p>
          
          <ul>
            <li><strong>Fase inicial (2 meses):</strong> Isoniazida + Rifampicina + Pirazinamida + Etambutol</li>
            <li><strong>Fase de continuación (4 meses):</strong> Isoniazida + Rifampicina</li>
          </ul>
          
          <Imagen
            src={imgEjemplo}
            alt="Esquema de tratamiento"
          />
        </Fragment>

        <Fragment slot="imagenes-tab">
          <h3>Galería de Imágenes</h3>
          <p>Ejemplo usando nombre de slot personalizado</p>
          
          <Carrusel 
            id="carrusel-ejemplo"
            slides={[
              { id: 1, imagen: imgEjemplo, alt: 'Imagen 1', title: 'Ejemplo 1', pie: 'Primera imagen de ejemplo' },
              { id: 2, imagen: imgEjemplo, alt: 'Imagen 2', title: 'Ejemplo 2', pie: 'Segunda imagen de ejemplo' },
              { id: 3, imagen: imgEjemplo, alt: 'Imagen 3', title: 'Ejemplo 3', pie: 'Tercera imagen de ejemplo' }
            ]}
          />
        </Fragment>
      </Tabs>
    </section>

    <section style="margin-bottom: 4rem;">
      <h2>Ejemplo 3: Acordeon Mixto (Slots + Strings)</h2>
      <p style="color: #6c757d; margin-bottom: 1rem;">
        Puedes mezclar items con componentes (slots) e items con HTML simple (strings)
      </p>
      
      <Acordeon 
        allowMultiple={true}
        items={[
          { 
            titulo: 'Item con componente',
          },
          { 
            titulo: 'Item con HTML string',
            contenido: '<p>Este es <strong>contenido HTML simple</strong> sin componentes.</p><p>Útil para texto básico.</p>'
          },
          { 
            titulo: 'Otro item con componente',
            slotName: 'custom-slot-name'
          }
        ]}
      >
        <Fragment slot="item-0">
          <p>Este item contiene un componente de imagen:</p>
          <Imagen
            src={imgEjemplo}
            alt="Imagen en acordeon"
          />
        </Fragment>

        <Fragment slot="custom-slot-name">
          <p>Este item usa un nombre de slot personalizado</p>
          <Imagen
            src={imgEjemplo}
            alt="Otra imagen"
          />
          <p style="margin-top: 1rem;">Puedes agregar múltiples componentes en el mismo slot</p>
        </Fragment>
      </Acordeon>
    </section>
  </main>
</Layout>
