---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Bibliografia from "@/components/Bibliografia.astro";
import Tarjetas from "@/components/Tarjetas.astro";
import TarjetasGiratorias from "@/components/TarjetasGiratorias.astro";
import Imagen from "@/components/Imagen.astro";
import ImagenClip from "@/components/ImagenClip.astro";
import Hotspot from "@/components/Hotspot.astro";
import { siteConfig, configsHotspot } from "@/config";
import Carrusel from "@/components/Carrusel.astro";
import Acordeon from "@/components/Acordeon.astro";
import FicheroHorizontal from "@/components/FicheroHorizontal.astro";
import FicheroVertical from "@/components/FicheroVertical.astro";
import LineaTiempo from "@/components/LineaTiempo.astro";

// Importar imágenes para el carrusel (5 imágenes)
import img1 from "@assets/img/diabetesGes.png";
import img2 from "@assets/img/incidencia_diabetes.jpg";
import img3 from "@assets/img/gasto_sanitario.jpg";
import img4 from "@assets/img/mortalidad.jpg";
import img5 from "@assets/img/diabetes.jpg";

import diabetesGes from "@assets/img/diabetesGes.png";
import diabetesNoDiag from "@assets/img/diabetesNoDiag.png";
import tlalocU2 from "@assets/img/tlaloc_u2.png";
import { object } from "astro:schema";

// Configurar la imagen del hotspot
const hotspotEjemplo = {
  ...configsHotspot.ejemplo1,
  imagen: diabetesNoDiag,
};
---

<Layout recurso={siteConfig.recurso} nombreCurso={siteConfig.nombreCurso}>
  <Hero />
  <h1>Hola</h1>
  <h2>que onda</h2>
  <h3>como estás</h3>
  <h4>yo bien gracias</h4>
  <h5>ok camara</h5>
  <!-- tarjetas -->
  <section class="tarjetas container mx-auto">
    <Tarjetas titulo="lorem" colorClase="carta1">
      <p>
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Blanditiis
        impedit corrupti animi, tempora ex quibusdam. Cupiditate
      </p>
    </Tarjetas>
    <Tarjetas titulo="lorem" colorClase="carta2">
      <p>
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Blanditiis
        impedit corrupti animi, tempora ex quibusdam. Cupiditate
      </p>
    </Tarjetas>
    <Tarjetas titulo="lorem" colorClase="carta3">
      <p>
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Blanditiis
        impedit corrupti animi, tempora ex quibusdam. Cupiditate
      </p>
    </Tarjetas>
    <Tarjetas titulo="lorem" colorClase="carta4">
      <p>
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Blanditiis
        impedit corrupti animi, tempora ex quibusdam. Cupiditate
      </p>
    </Tarjetas>
  </section>
  <!-- fin tarjetas -->

  <TarjetasGiratorias
    id="tarjetas-giratorias-prehispanico"
    tarjetas={[
      {
        id: "mexico-prehispanico",
        variante: "carta1",
        frente: {
          subtitulo: "México prehispánico",
          titulo: "Tláloc y la salud",
          imagen: tlalocU2,
          alt: "Glifo de Tláloc",
          pie: "Wikimedia. (2011). <em>Tláloc</em> [imagen]. Tomada de https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/Tlaloc_glyph.svg/500px-Tlaloc_glyph.svg.png",
        },
        vuelta: {
          titulo: "Deidades asociadas a padecimientos",
          contenido: `
            <p>Entre los mexicas, Tláloc estaba vinculado a las enfermedades relacionadas con el agua; por ejemplo, hidropesía. Xipe Tótec, deidad de la renovación de la naturaleza en la primavera, estaba asociado a los padecimientos dermatológicos. Ixtlilton era el protector de niñas y niños.</p>
          `,
        },
      },
    ]}
  />

  <section>
    <Imagen
      src={diabetesGes}
      alt="Desnutrición"
      title="Desnutrición"
      pie="<em>Desnutrición</em> [Ilustración]."
    />

    <ImagenClip
      src={diabetesNoDiag}
      alt="Desnutrición"
      title="Desnutrición"
      pie='<em>Desnutrición</em> [Ilustración]. <span class="text-break">https://www.liderempresarial.com/estos-son-los-mejores-hospitales-del-pais-en-la-ciudad-de-mexico-segun-newsweek/</span>'
    />
  </section>

  <Hotspot ancho="w-full!" config={hotspotEjemplo} />

  <Carrusel
    id="carrusel-1"
    slides={[
      {
        id: 1,
        imagen: img1,
        alt: "Descripción",
        title: "Título",
        pie: "Pie de foto",
        contenido: "<p>Contenido opcional</p>",
      },
      {
        id: 2,
        imagen: img2,
        alt: "Otra imagen",
        title: "Otro título",
        pie: "Otro pie",
      },
    ]}
  />
  <Acordeon
    id="acordeon-vert-1"
    items={[
      {
        id: 1,
        titulo: "Sección 1",
        contenido: `<p>Contenido aquí...</p>`,
      },
      {
        id: 2,
        titulo: "Sección 2",
        contenido: `<p>Otro contenido...</p>`,
      },
    ]}
  />
  <FicheroHorizontal
    id="fichero-hor-1"
    items={[
      {
        titulo: "2001-2006",
        contenido: `
        <p>Se implementó y se desarrolló por primera vez la "Cruzada Nacional por la Calidad"...</p>
        <div class="imagenPie">
          <img src="${img4.src}" alt="Imagen 1" />
          <p>Pie de imagen...</p>
        </div>
      `,
      },
      {
        titulo: "2007-2012",
        contenido: `<p>Se estableció el programa "Sicalidad"...</p>`,
      },
    ]}
  />

  <FicheroVertical
    id="fichero-vert-1"
    items={[
      {
        titulo: "Sección 1",
        contenido: `
        <p>Contenido...</p>
        <ul>
          <li>Item 1</li>
          <li>Item 2</li>
        </ul>
      `,
      },
      {
        titulo: "Sección 2",
        contenido: `
        <div class="imagenPie">
          <img src="${img4.src}" alt="Descripción" />
          <p>Pie de imagen</p>
        </div>
        <p>Más contenido...</p>
      `,
      },
    ]}
  />

  <LineaTiempo
    id="linea-tiempo-horizontal-1"
    orientation="horizontal"
    accentColor="#0069d9"
    items={[
      {
        fecha: "2001-2006",
        titulo: "Cruzada Nacional por la Calidad",
        contenido: `<p>Se implemento una estrategia nacional para impulsar procesos de mejora continua en los servicios de salud.</p>`,
      },
      {
        fecha: "2007-2012",
        titulo: "Programa Sicalidad",
        contenido: `<p>Se consolidaron acciones para medir, documentar y fortalecer la calidad de la atencion.</p>`,
      },
      {
        fecha: "2013-2018",
        titulo: "Seguimiento institucional",
        contenido: `<p>Los indicadores de calidad comenzaron a utilizarse como apoyo para la toma de decisiones.</p>`,
      },
      {
        fecha: "2019-2024",
        titulo: "Actualizacion de procesos",
        contenido: `<p>Los equipos incorporaron herramientas digitales para acompanar la gestion y el seguimiento.</p>`,
      },
    ]}
  />

  <LineaTiempo
    id="linea-tiempo-vertical-1"
    orientation="vertical"
    accentColor="#C99335"
    items={[
      {
        fecha: "Paso 1",
        titulo: "Identificar el problema",
        contenido: `<p>Definir con claridad que proceso necesita observarse antes de proponer una mejora.</p>`,
      },
      {
        fecha: "Paso 2",
        titulo: "Analizar evidencias",
        contenido: `<p>Revisar datos, fuentes y observaciones para tomar decisiones basadas en informacion.</p>`,
      },
      {
        fecha: "Paso 3",
        titulo: "Aplicar ajustes",
        contenido: `<p>Implementar cambios controlados y documentar los resultados obtenidos.</p>`,
      },
    ]}
  />

  <Bibliografia />
</Layout>
