---
export interface Props {
  titulo?: string;
  recurso?: string;
  nombreCurso?: string;
  creditos?: boolean;
}

import { siteConfig } from "@/config";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import "@/styles/estilos.css";
import "@/styles/bootstrap.css";
import "@/styles/aos.css";

export let titulo: string =
  siteConfig.titulo ?? "Educación Continua SUAYED - Facultad de Medicina UNAM";
export let recurso: string = siteConfig.recurso ?? '';
export let nombreCurso: string = siteConfig.nombreCurso ?? '';
const { creditos = true } = Astro.props;

// Función para quitar HTML tags del título (para el <title> que no acepta HTML)
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '');

// Build final title: prefer explicit `titulo`, otherwise compose from recurso + nombreCurso + site title
const tituloFinal = titulo
  ? stripHtml(titulo)
  : `${recurso ? stripHtml(recurso) + ' - ' : ''}${nombreCurso ? stripHtml(nombreCurso) + ' - ' : ''}${siteConfig.titulo}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- CSS importado vía frontmatter y bundleado -->
    <meta name="generator" content={Astro.generator} />
    <title>{tituloFinal}</title>
  </head>
  <body>
		<main>
			<slot />
		</main>
    <Footer creditos={creditos} />
    <script is:inline src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
