---
export interface Props {
  titulo?: string;
  recurso?: string;
  nombreCurso?: string;
}

import { siteConfig } from "@/config";
export let titulo: string =
  siteConfig.titulo ?? "Educación Continua SUAYED - Facultad de Medicina UNAM";
export let recurso: string = siteConfig.recurso ?? '';
export let nombreCurso: string = siteConfig.nombreCurso ?? '';
// Build final title: prefer explicit `titulo`, otherwise compose from recurso + nombreCurso + site title
const tituloFinal = titulo
  ? titulo
  : `${recurso ? recurso + ' - ' : ''}${nombreCurso ? nombreCurso + ' - ' : ''}${siteConfig.titulo}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/estilos.css" />
    <link rel="stylesheet" href="/src/styles/bootstrap.css" />
    <link rel="stylesheet" href="/src/styles/aos.css" />
    <link rel="stylesheet" href="/src/styles/hotspot.css" />
    <link rel="stylesheet" href="/src/styles/carrusel.css" />
    <link rel="stylesheet" href="/src/styles/acordeon.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloFinal}</title>
  </head>
  <body>
		<main>
			<slot />
		</main>
		<script src="/src/assets/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
